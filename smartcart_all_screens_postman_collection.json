	},
	"item": [
		{
			"name": "1. Authentication & Profile",
			"item": [
				{
					"name": "Signup (Register)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Aarav Mehta\",\n  \"email\": \"aarav.mehta@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": "http://localhost/smartcart_backend/auth/signup.php"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"aarav.mehta@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": "http://localhost/smartcart_backend/auth/login.php"
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"url": "http://localhost/smartcart_backend/auth/profile.php?email=aarav.mehta@example.com"
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"aarav.mehta@example.com\",\n  \"name\": \"Aarav Mehta Updated\"\n}"
						},
						"url": "http://localhost/smartcart_backend/auth/update_profile.php"
					}
				},
				{
					"name": "Upload Profile Photo",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [
								{"key": "email", "value": "aarav.mehta@example.com", "type": "text"},
								{"key": "profile_image", "type": "file", "src": ""}
							]
						},
						"url": "http://localhost/smartcart_backend/auth/upload_profile.php"
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"aarav.mehta@example.com\",\n  \"new_password\": \"newpassword123\"\n}"
						},
						"url": "http://localhost/smartcart_backend/auth/reset_password.php"
					}
				}
			]
		},
