{
	"info": {
		"_postman_id": "smartcart-ai-complete-api-collection",
		"name": "SmartCart AI - Complete Backend APIs (All Screens)",
		"description": "Comprehensive Postman collection for all SmartCart AI backend endpoints covering Home, Discover, Search, Product Details, AI Analysis, Comparisons, Wishlist, Cart, Price Tracking, and Preferences.",
